Algoritmo area_rombo
	definir dmen, dmay, aromb Como Real
	
	Escribir "Digite la diagonal menor:"
	Leer dmen
	
	Escribir "Digite la diagonal mayor:"
	Leer dmay
	
	aromb <- (dmen * dmay) / 2
	
	Escribir "Diagonal menor: ", dmen
	Escribir "Diagonal mayor: ", dmay
	Escribir "Area del rombo: ", aromb
FinAlgoritmo