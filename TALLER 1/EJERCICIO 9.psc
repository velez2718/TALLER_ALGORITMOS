Algoritmo area_trapecio
	Definir bmen, bmay, h, atrap Como Real
	
	Escribir "Digite la base menor:"
	Leer bmen
	
	Escribir "Digite la base mayor:"
	Leer bmay
	
	Escribir "Digite la altura:"
	Leer h
	
	atrap <- ((bmen + bmay) / 2) * h
	
	Escribir "Base menor: ", bmen
	Escribir "Base mayor: ", bmay
	Escribir "Altura: ", h
	Escribir "Area del trapecio: ", atrap
FinAlgoritmo